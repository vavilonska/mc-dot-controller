                      "north",
                      "east",
                      "south",
                      "west"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "clearance": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "purpose"
        ],
        "properties": {
          "position": {
            "$ref": "#/$defs/position"
          },
          "purpose": {
            "enum": [
              "cavity",
              "interior",
              "access"
            ]
          }
        }
      }
    },
    "light_checks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "min_block_light"
        ],
        "properties": {
          "position": {
            "$ref": "#/$defs/position"
          },
          "min_block_light": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          }
        }
      }
    },
    "access_points": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8192,
      "items": {
        "$ref": "#/$defs/position"
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -29999984,
          "maximum": 29999984
        },
        "y": {
          "type": "integer",
          "minimum": -64,
          "maximum": 319
        },
        "z": {
          "type": "integer",
          "minimum": -29999984,
          "maximum": 29999984
        }
      }
    }
  },
  "$comment": "Runtime parser additionally verifies SHA256, coordinate containment, duplicate positions, exact paired door halves, bounded region edges and state connectivity. Schema validation alone cannot authorize construction."
}
