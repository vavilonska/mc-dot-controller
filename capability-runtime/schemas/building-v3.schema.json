                ],
                "properties": {
                  "north": {
                    "enum": [
                      "false",
                      "true"
                    ]
                  },
                  "east": {
                    "enum": [
                      "false",
                      "true"
                    ]
                  },
                  "south": {
                    "enum": [
                      "false",
                      "true"
                    ]
                  },
                  "west": {
                    "enum": [
                      "false",
                      "true"
                    ]
                  },
                  "waterlogged": {
                    "enum": [
                      "false"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "block",
              "properties"
            ],
            "properties": {
              "position": {
                "$ref": "#/$defs/position"
              },
              "block": {
                "enum": [
                  "minecraft:blast_furnace",
                  "minecraft:furnace",
                  "minecraft:smoker"
                ]
              },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "facing",
                  "lit"
                ],
                "properties": {
                  "facing": {
                    "enum": [
                      "north",
                      "east",
                      "south",
                      "west"
                    ]
                  },
                  "lit": {
                    "enum": [
                      "false"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "block",
              "properties"
            ],
            "properties": {
              "position": {
                "$ref": "#/$defs/position"
              },
              "block": {
                "enum": [
                  "minecraft:soul_torch",
                  "minecraft:torch"
                ]
              },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "block",
              "properties"
            ],
            "properties": {
              "position": {
                "$ref": "#/$defs/position"
              },
              "block": {
                "enum": [
                  "minecraft:soul_wall_torch",
                  "minecraft:wall_torch"
                ]
              },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
