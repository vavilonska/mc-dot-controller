      "type": "object",
      "properties": {
        "api_version": {
          "type": "string",
          "const": "mdc.toolbox/1"
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "capability_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,79}$",
            "maxLength": 80
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "detail": {
          "type": "string",
          "enum": [
            "summary",
            "contracts"
          ]
        },
        "cursor": {
          "type": "string",
          "pattern": "^[0-9]{1,8}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      },
      "required": [
        "api_version"
      ],
      "additionalProperties": false
    },
