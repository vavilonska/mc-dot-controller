{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdc:toolbox:1",
  "title": "MDC toolbox v1 tool invocation",
  "type": "object",
  "properties": {
    "tool": {
      "type": "string",
      "enum": [
        "mdc_catalog",
        "mdc_observe",
        "mdc_plan",
        "mdc_job"
      ]
    },
    "arguments": {
      "type": "object"
    }
  },
  "required": [
    "tool",
    "arguments"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "tool": {
            "const": "mdc_catalog"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/mdc_catalog"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "mdc_observe"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/mdc_observe"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "mdc_plan"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/mdc_plan"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "mdc_job"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/mdc_job"
          }
        }
      }
    }
  ],
  "$defs": {
