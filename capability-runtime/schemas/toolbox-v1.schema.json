            "defense": {
              "type": "object",
              "properties": {
                "target_uuid": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 50,
                  "maximum": 5000
                },
                "min_health": {
                  "type": "number",
                  "minimum": 14,
                  "maximum": 20
                }
              },
              "required": [
                "target_uuid",
                "timeout_ms",
                "min_health"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "version",
            "execution_mode"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "reactions": {
                    "const": "defend_once"
                  }
                },
                "required": [
                  "reactions"
                ]
              },
              "then": {
                "required": [
                  "defense"
                ],
                "properties": {
                  "execution_mode": {
                    "enum": [
                      "guarded",
                      "request_only"
                    ]
                  }
                }
              },
              "else": {
                "not": {
