            "max_observations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            },
            "reflex_reserve_actions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "cleanup_reserve_actions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
